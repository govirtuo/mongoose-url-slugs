{
  "name": "@govirtuo/mongoose-url-slugs",
  "version": "2.0.0-rc.dev-20329.1",
  "description": "Create URL compatible slugs on mongoose models, ensuring uniqueness.",
  "keywords": [
    "mongoose slugs",
    "mongoose url slugs",
    "url slugs",
    "mongodb slugs",
    "mongodb url slugs",
    "mongoose"
  ],
  "homepage": "https://github.com/govirtuo/mongoose-url-slugs",
  "repository": {
    "type": "git",
    "url": "https://github.com/govirtuo/mongoose-url-slugs.git"
  },
  "license": "MIT",
  "main": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "files": [
    "dist/src",
    "Readme.md"
  ],
  "scripts": {
    "build": "npm run clean && tsc --pretty",
    "clean": "rimraf dist",
    "format": "oxfmt 'src/**/*.ts' 'test/**/*.ts'",
    "format:check": "npm run format -- --check",
    "lint": "oxlint",
    "lint:fix": "npm run format && oxlint --fix",
    "major-release": "npm version major && npm publish",
    "major-release-candidate": "npm version premajor --preid rc && npm publish --tag beta",
    "minor-release": "npm version minor && npm publish",
    "minor-release-candidate": "npm version preminor --preid rc && npm publish --tag beta",
    "next-release-candidate": "npm version prerelease --preid rc && npm publish --tag beta",
    "patch-release": "npm version patch && npm publish",
    "patch-release-candidate": "npm version prepatch --preid rc && npm publish --tag beta",
    "postpublish": "git push --follow-tags",
    "prepack": "npm run lint && npm run build",
    "preversion": "npm run lint && npm run test && npm run build",
    "test": "npm run build && node --test --enable-source-maps --test-reporter spec --test-force-exit 'dist/test/**/*.js'"
  },
  "peerDependencies": {
    "mongoose": "^9.0.0"
  },
  "devDependencies": {
    "@govirtuo/oxc-config": "^0.4.0",
    "@types/node": "^24.10.1",
    "mongoose": "^9.9.5",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.86.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com/"
  },
  "engines": {
    "node": ">=24"
  }
}
